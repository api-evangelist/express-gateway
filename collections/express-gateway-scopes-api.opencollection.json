          },
          "http": {
            "method": "POST",
            "url": "http://localhost:9876/scopes",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create scopes"
        },
        {
          "info": {
            "name": "Check whether a scope exists",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:9876/scopes/:scope",
            "params": [
              {
                "name": "scope",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Check whether a scope exists"
        },
        {
          "info": {
            "name": "Create a single scope",
            "type": "http"
          },
          "http": {
            "method": "PUT",
