            "params": [
              {
                "name": "scope",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Create a single scope"
        },
        {
          "info": {
            "name": "Delete a scope",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "http://localhost:9876/scopes/:scope",
            "params": [
              {
                "name": "scope",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a scope"
        }
      ]
    }
  ],
